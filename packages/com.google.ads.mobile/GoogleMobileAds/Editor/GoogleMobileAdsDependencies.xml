<dependencies>
  <androidPackages>
    <androidPackage spec="com.google.android.gms:play-services-ads:25.5.0">
      <repositories>
        <repository>https://maven.google.com/</repository>
      </repositories>
    </androidPackage>
    <androidPackage spec="androidx.constraintlayout:constraintlayout:2.1.4">
      <repositories>
        <repository>https://maven.google.com/</repository>
      </repositories>
    </androidPackage>
    <androidPackage spec="androidx.lifecycle:lifecycle-process:2.6.2">
        <repositories>
            <repository>https://maven.google.com/</repository>
        </repositories>
    </androidPackage>
    <androidPackage spec="androidx.fragment:fragment:1.7.1">
        <repositories>
            <repository>https://maven.google.com/</repository>
        </repositories>
    </androidPackage>
  </androidPackages>

  <remoteSwiftPackages>
    <remoteSwiftPackage url="https://github.com/googleads/swift-package-manager-google-mobile-ads.git" version="13.11.0" upToNextMajor="true">
      <swiftPackage name="GoogleMobileAds" replacesPod="Google-Mobile-Ads-SDK"/>
    </remoteSwiftPackage>
  </remoteSwiftPackages>

  <iosPods>
    <iosPod name="Google-Mobile-Ads-SDK" version="~> 13.11">
      <sources>
        <source>https://github.com/CocoaPods/Specs</source>
      </sources>
    </iosPod>
  </iosPods>
</dependencies>
